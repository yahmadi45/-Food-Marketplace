# Copy to .env.prod and replace every example value before deployment.
DOCKERHUB_USER=your-dockerhub-user
IMAGE_TAG=latest
DOMAIN=your-domain.example

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_APP_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
PROMETHEUS_RETENTION=15d
BACKUP_RETENTION_DAYS=14
BACKUP_PATH=./backups
